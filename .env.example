# ============================================================
# Döküm Takip Sistemi — Ortam Değişkenleri
# Yerel geliştirme: bu dosyayı .env.local olarak kopyalayın.
# Vercel: Project Settings > Environment Variables bölümünden ekleyin.
# ============================================================

# --- Supabase (production için ZORUNLU) ---
# Supabase Dashboard > Project Settings > API
# Tanımlı değilse uygulama yerel dosya DB'sine (data/db.json) düşer.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# service_role anahtarı — GİZLİDİR, yalnızca sunucuda kullanılır (opsiyonel)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Oturum güvenliği (production için ZORUNLU) ---
# JWT imzalama anahtarı. Üretmek için: openssl rand -base64 32
AUTH_SECRET="uzun-rastgele-bir-anahtar-uretin"

# --- Gemini AI (Kontrol Paneli'ndeki AI analizi için) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
